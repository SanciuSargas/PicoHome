{
  // Template for the broker login. Copy to config/secrets.json (git-ignored),
  // fill in the real values, then copy that file to the SD card root next to
  // config.json:
  //
  //     cp config/secrets.example.json config/secrets.json
  //     $EDITOR config/secrets.json
  //     cp config/config.json config/secrets.json /run/media/$USER/<CARD>/
  //
  // Optional: with no secrets.json on the card the controller uses whatever
  // config.json carries, which may be nothing at all — an anonymous connect.
  // Present but malformed is a boot error, so a typo here never degrades
  // quietly into connecting without credentials.
  //
  // Only the keys named here are replaced, and they override config.json.
  //
  // Give each controller its own broker account, restricted by ACL to its own
  // building's topic tree, e.g. in mosquitto's acl_file:
  //
  //     user utility_panel
  //     topic readwrite utility/#
  //
  // Both values travel in the clear (no TLS on the W5100) and sit in the clear
  // on a FAT32 card, so use a password that matters only inside this LAN.
  "network": {
    "username": "utility_panel",
    "password": "change_me"
  }
}
